# Copy to .env.local and fill in. Never commit .env.local. (Tech Stack §14)
# AUTH_SECRET / NEXTAUTH_SECRET intentionally omitted — unused by this stack (decision D6).

# Supabase — local dev values come from `supabase status -o env`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Server only
GEMINI_API_KEY=

# Server only. Without a verified domain use onboarding@resend.dev
# (Resend then delivers only to the Resend account owner's address).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only — validated by /api/cron/* route handlers
CRON_SECRET=
